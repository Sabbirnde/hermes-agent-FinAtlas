# COMPARE AI — Environment Variables Template
# Copy this file to .env.compare-ai and fill in your values.

# ── LLM Provider ─────────────────────────────────────────────────────────────
# OpenRouter (recommended — access to all major models)
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=your_openrouter_key_here
COMPARE_AI_MODEL=anthropic/claude-sonnet-4-5

# ── Web Search ────────────────────────────────────────────────────────────────
# At least one is required for web research
SERPER_API_KEY=your_serper_key_here
FIRECRAWL_API_KEY=your_firecrawl_key_here

# ── Database ──────────────────────────────────────────────────────────────────
# Local SQLite (default for development)
COMPARE_AI_DB_URL=sqlite+aiosqlite:///./compare_ai.db

# Supabase PostgreSQL (for production)
# COMPARE_AI_DB_URL=postgresql+asyncpg://user:password@host:5432/compare_ai

# ── Redis (optional for caching) ──────────────────────────────────────────────
# COMPARE_AI_REDIS_URL=redis://localhost:6379/0

# ── App Settings ──────────────────────────────────────────────────────────────
DEBUG=true
RESEARCH_CACHE_TTL=21600          # 6 hours in seconds
FRESHNESS_THRESHOLD_DAYS=30       # Days before a source is "stale"

# ── Hermes Home (agent backend) ───────────────────────────────────────────────
# HERMES_HOME=C:\Users\USER\AppData\Local\hermes
